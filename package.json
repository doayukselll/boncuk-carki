{
  "name": "boncuk-carki",
  "version": "1.0.0",
  "private": true,
  "description": "Boncuk Çarkı - halka çevirmeli renk bulmacası",
  "scripts": {
    "serve": "node tools/serve.js",
    "icons": "powershell -ExecutionPolicy Bypass -File tools/make-icons.ps1 && npx @capacitor/assets generate --android --ios --iconBackgroundColor #0f1b2e --splashBackgroundColor #0f1b2e",
    "sync": "npx cap sync",
    "android": "npx cap sync android && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
